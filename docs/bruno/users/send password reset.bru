meta {
  name: send password reset
  type: http
  seq: 7
}

post {
  url: {{base_url}}administrator/users/:id/send-password-reset/
  body: none
  auth: inherit
}

params:path {
  id: 3
}

docs {
  ## API explanation
  E-mails the user a password reset link (FR-5.3), the same e-mail as
  forgot password/submit email. **Admin only**. The user must be active.
  Audited as `USER_PASSWORD_RESET_TRIGGERED`.


  ## API example response
  {
    "success": true,
    "message": "Password reset e-mail sent to nadia.islam@example.com."
  }
}

settings {
  encodeUrl: true
}
