        "component_id": 6,
        "component": "5V Relay Module",
        "part_number": null,
        "category": "Miscellaneous",
        "unit_symbol": "pcs",
        "total_quantity": "0.000",
        "stock_status": "OUT_OF_STOCK",
        "chambers_held": 0,
        "locations": [],
        "last_buying_price": null,
        "delivery_charge": null,
        "estimated_stock_value": null
      },
      {
        "component_id": 7,
        "component": "AMS1117 3.3V Regulator",
        "part_number": "AMS1117-3.3",
        "category": "Voltage Regulators",
        "unit_symbol": "pcs",
        "total_quantity": "150.000",
        "stock_status": "IN_STOCK",
        "chambers_held": 1,
        "locations": [
          "C21"
        ],
        "last_buying_price": "6.50",
        "delivery_charge": null,
        "estimated_stock_value": "975.00"
      }
    ],
    "columns": [
      {
        "key": "component",
        "header": "Component"
      },
      {
        "key": "part_number",
        "header": "Part number"
      }
    ],
    "summary": {
      "components": 8,
      "total_estimated_stock_value": "22048.00"
    }
  }

