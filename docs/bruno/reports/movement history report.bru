meta {
  name: movement history report
  type: http
  seq: 4
}

get {
  url: {{base_url}}reports/movements/?movement_type=TAKE
  body: none
  auth: inherit
}

params:query {
  movement_type: TAKE
  ~export: csv
  ~component: 1
  ~performed_by: 3
  ~project: 1
  ~location: A11
  ~date_from: 2026-09-01
  ~date_to: 2026-09-30
  ~p: 1
  ~page_size: 25
}

docs {
  ## API explanation
  All movements with date, type, component, quantity, from/to locations,
  unit price, user, project and note. Any role; **Staff only see their own
  movements** ("own activity only", FR-5.2).

  Filters: `component`, `performed_by` (user id), `project`, `movement_type`
  (`ADD` | `TAKE` | `RETURN` | `TRANSFER` | `ADJUST`), `location` (a chamber
  code that is the source or destination), `date_from` / `date_to` (YYYY-MM-DD,
  inclusive).

  Like every report (FR-9.1): a paginated JSON table with `columns` (key and header)
  and, where it applies, a `summary`. Add `?export=xlsx` or `?export=csv` to download
  the whole report (every page) as a file; quantities are written with their unit symbol.

  ## API example response
  {
    "count": 3,
    "page_size": 25,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": 8,
        "created_at": "2026-09-14T22:17:36.679144+06:00",
        "movement_type": "TAKE",
        "component_id": 4,
        "component": "NEMA17 Stepper Motor",
        "part_number": "17HS4401",
        "unit_symbol": "pcs",
        "quantity": "3.000",
        "source_location": "C11",
        "destination_location": null,
        "unit_price": null,
        "performed_by": "nadia.islam",
        "project": "Solar Charge Controller",
        "note": ""
      },
      {
        "id": 7,
        "created_at": "2026-09-14T22:17:36.670969+06:00",
        "movement_type": "TAKE",
        "component_id": 3,
        "component": "Hookup Wire 22AWG Red",
        "part_number": "UL1007-22-RED",
        "unit_symbol": "m",
        "quantity": "12.500",
        "source_location": "B21",
        "destination_location": null,
        "unit_price": null,
        "performed_by": "nadia.islam",
        "project": "Line Follower Robot",
        "note": "Wiring harness"
      }
    ],
    "columns": [
      {
        "key": "created_at",
        "header": "Date"
      },
      {
        "key": "movement_type",
        "header": "Type"
      }
    ]
  }
}

settings {
  encodeUrl: true
}
