meta {
  name: user activity report
  type: http
  seq: 8
}

get {
  url: {{base_url}}reports/user-activity/
  body: none
  auth: inherit
}

params:query {
  ~export: csv
  ~performed_by: 3
  ~date_from: 2026-09-01
  ~date_to: 2026-09-30
  ~p: 1
  ~page_size: 25
}

docs {
  ## API explanation
  Take and return volume per user over a date range: number of takes, number
  of returns, distinct components taken and last activity. Any role; **Staff
  only get their own row**. Filters: `performed_by` (user id; Admin/Manager),
  `date_from` / `date_to`.

  Like every report (FR-9.1): a paginated JSON table with `columns` (key and header)
  and, where it applies, a `summary`. Add `?export=xlsx` or `?export=csv` to download
  the whole report (every page) as a file; quantities are written with their unit symbol.

  ## API example response
  {
    "count": 1,
    "page_size": 25,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "user_id": 3,
        "username": "nadia.islam",
        "email": "nadia.islam@example.com",
        "role": "STAFF",
        "take_count": 3,
        "return_count": 1,
        "components_taken": 3,
        "last_activity": "2026-09-14T22:17:36.679144+06:00"
      }
    ],
    "columns": [
      {
        "key": "username",
        "header": "User"
      },
      {
        "key": "email",
        "header": "Email"
      }
    ]
  }
}

settings {
  encodeUrl: true
}
