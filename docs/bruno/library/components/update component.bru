meta {
  name: update component
  type: http
  seq: 4
}

patch {
  url: {{base_url}}library/components/:id/
  body: json
  auth: inherit
}

params:path {
  id: 1
}

body:json {
  {
    // Any field from "create component"; all optional on PATCH.
    "minimum_quantity": "15",
    "description": "12V 107 RPM DC gear motor with hall encoder, 6mm D-shaft"
  }
}

docs {
  ## API explanation
  Edits a component (PUT for a full update). Admin or Manager. Returns the full
  detail. Switching to a whole-number unit is rejected while the component
  has fractional stock. Audited (changed fields only).


  ## API example response
  {
    "id": 1,
    "image_url": "https://transfer2.ongshak.com/components-inventory/jgb37-520.jpg",
