meta {
  name: restore component
  type: http
  seq: 6
}

post {
  url: {{base_url}}library/components/:id/restore/
  body: none
  auth: inherit
}

params:path {
  id: 4
}

docs {
  ## API explanation
  Un-archives a component. Admin or Manager. Audited as `COMPONENT_RESTORED`.

