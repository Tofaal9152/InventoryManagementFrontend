meta {
  name: list units
  type: http
  seq: 1
}

get {
  url: {{base_url}}library/units/
  body: none
  auth: inherit
}

params:query {
  ~p: 1
  ~page_size: 25
}

docs {
  ## API explanation
  Units of measure with `component_count`. Any role. Seeded units: Pieces
  (pcs), Metres (m), Centimetres (cm), Grams (g), Kilograms (kg), Rolls
  (roll), Sets (set). When `allows_fraction` is false, every quantity in that
  unit must be a whole number (FR-3.4).


  ## API example response
  {
    "count": 7,
    "page_size": 25,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": 3,
        "name": "Centimetres",
        "symbol": "cm",
        "allows_fraction": true,
        "component_count": 0,
