meta {
  name: list requisitions
  type: http
  seq: 1
}

get {
  url: {{base_url}}requisitions/?ordering=-created_at
  body: none
  auth: inherit
}

params:query {
  ordering: -created_at
  ~status: PENDING
  ~mine: true
  ~requested_by: 3
  ~project: 1
  ~component: 2
  ~search: esp32
  ~date_from: 2026-09-01
  ~date_to: 2026-09-30
  ~p: 1
  ~page_size: 25
}

docs {
  ## API explanation
  Requisitions (FR-4.4) with the request ID (`reference`), component or
  requested part name, quantity, requester, project, status, `created_at`,
  `needed_by` and `days_in_current_status`. Any role.

  Filters: `status`, `requested_by` (user id), `mine` (`true`: only yours),
  `project`, `component`, `search` (part name, component name or part number),
  `date_from` / `date_to` (created date). Sorting: `ordering` = `created_at` |
  `needed_by` | `status` | `status_changed_at` (default `-created_at`).


  ## API example response
