meta {
  name: get requisition
  type: http
  seq: 4
}

get {
  url: {{base_url}}requisitions/:id/
  body: none
  auth: inherit
}

params:path {
  id: 2
}

docs {
  ## API explanation
  Requisition detail (FR-4.3). Any role. Adds `allowed_transitions` from the
  current status and the full `status_history` (who changed it, when, previous
  status, note).


  ## API example response
  {
    "id": 2,
    "reference": "REQ-000002",
    "component": {
      "id": 9,
      "name": "ESP32-DevKitC V4",
      "part_number": "ESP32-DEVKITC-V4",
      "unit_symbol": "pcs"
    },
    "requested_part_name": "ESP32-DevKitC V4",
    "part_name": "ESP32-DevKitC V4",
    "quantity": "5.000",
    "unit": {
      "id": 1,
      "name": "Pieces",
      "symbol": "pcs",
      "allows_fraction": false
    },
    "project": {
