      "part_name": "ESP32-DevKitC V4",
      "quantity": "5.000",
      "unit": {
        "id": 1,
        "name": "Pieces",
        "symbol": "pcs",
        "allows_fraction": false
      },
      "project": {
        "id": 1,
        "name": "Line Follower Robot",
        "status": "ACTIVE"
      },
      "needed_by": "2026-10-01",
      "reason": "Wireless telemetry for the robot",
      "status": "APPROVED",
      "status_display": "Approved",
      "status_changed_at": "2026-09-14T22:17:36.938794+06:00",
      "days_in_current_status": 0,
      "requested_by": {
        "id": 3,
