  }

  Not an allowed next status (400):
  {
    "success": false,
    "message": "A rejected requisition cannot be changed to ordered."
  }

  Staff approving (403):
  {
    "success": false,
    "message": "Only Admins can change requisition status. Requesters can cancel their own requisition while it is pending."
  }
}

settings {
  encodeUrl: true
}
