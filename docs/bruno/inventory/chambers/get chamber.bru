meta {
  name: get chamber
  type: http
  seq: 2
}

get {
  url: {{base_url}}inventory/chambers/:code/
  body: none
  auth: inherit
}

params:path {
  code: A11
}

docs {
  ## API explanation
  One chamber by location code (case-insensitive): the page a printed QR label
  opens (FR-7.8). Any role. Includes `qr_url` (built from
  `CHAMBER_QR_URL_TEMPLATE`, default `{FRONTEND_URL}/chambers/{code}`) and the
  last 20 movements in or out of the chamber (Staff see only their own).


  ## API example response
  {
    "id": 1,
    "code": "A11",
    "number": 1,
    "state": "OCCUPIED",
    "highlighted": false,
