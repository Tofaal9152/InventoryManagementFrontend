        "updated_at": "2026-09-14T22:17:36.686376+06:00"
      },
      {
        "id": 5,
        "location": "B22",
        "chamber": 13,
        "component": {
          "id": 1,
          "name": "DC Gear Motor 12V",
          "part_number": "JGB37-520",
          "unit_symbol": "pcs"
        },
        "quantity": "10.000",
