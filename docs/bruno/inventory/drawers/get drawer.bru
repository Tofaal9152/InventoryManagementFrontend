meta {
  name: get drawer
  type: http
  seq: 3
}

get {
  url: {{base_url}}inventory/drawers/:id/
  body: none
  auth: inherit
}

params:path {
  id: 6
}

docs {
  ## API explanation
  The drawer panel (FR-7.6): each chamber with its state, component and
  quantity. Any role. Use the chamber codes with stock operations for the quick
  Take, Return and Transfer actions.


  ## API example response
  {
    "id": 6,
    "cabinet": 1,
    "code": "B2",
    "row": 2,
    "column": 2,
    "chamber_count": 3,
    "is_active": true,
    "chambers": [
      {
        "id": 6,
        "code": "B21",
        "number": 1,
        "state": "LOW_STOCK",
        "highlighted": false,
        "stock_entry": {
          "id": 3,
          "quantity": "18.000",
          "component": {
            "id": 3,
            "name": "Hookup Wire 22AWG Red",
            "part_number": "UL1007-22-RED",
            "unit_symbol": "m",
            "minimum_quantity": "20.000",
            "total_quantity": "18.000"
          }
        }
      },
      {
        "id": 13,
        "code": "B22",
        "number": 2,
        "state": "OCCUPIED",
        "highlighted": false,
        "stock_entry": {
          "id": 5,
          "quantity": "10.000",
          "component": {
            "id": 1,
            "name": "DC Gear Motor 12V",
            "part_number": "JGB37-520",
            "unit_symbol": "pcs",
            "minimum_quantity": "15.000",
            "total_quantity": "36.000"
          }
        }
      },
      {
        "id": 14,
        "code": "B23",
        "number": 3,
        "state": "EMPTY",
        "highlighted": false,
        "stock_entry": null
      }
    ]
  }
}

settings {
  encodeUrl: true
}
