meta {
  name: password change
  type: http
  seq: 3
}

post {
  url: {{base_url}}rest-auth/password/change/
  body: json
  auth: inherit
}

body:json {
  {
    // The current password. Required.
    "old_password": "Manager-pass-123",

    // The new password, entered twice. Required.
    "new_password1": "New-pass-456",
    "new_password2": "New-pass-456"
  }
}

docs {
  ## API explanation
  Changes the logged-in user's password (custom
  `administrator.auth_views.CustomPasswordChangeView`). Any role.


  ## API example response
  {
    "detail": "Password has been changed successfully."
  }

  New passwords don't match (400):
  {
    "success": false,
    "message": "The two new passwords must match."
  }

  Wrong old password (400):
  {
    "success": false,
    "message": "(old_password) Old password is incorrect."
  }

  ## Changelog
  - 2026-09-14: Corrected the documented errors. A wrong old_password returns the standard wrapped error (it had been documented as unwrapped), and errors not tied to a field no longer carry a `(non_field_errors)` prefix.
}

settings {
  encodeUrl: true
}
