meta {
  name: get user
  type: http
  seq: 6
}

get {
  url: {{base_url}}rest-auth/user/
  body: none
  auth: inherit
}

docs {
  ## API explanation
  The logged-in user's basic profile (dj-rest-auth `UserDetailsView`). Any
  role. This default serializer has no `role` field; use "login" or
  users/get user for that.


  ## API example response
  {
    "pk": 2,
    "username": "karim.hossain",
    "email": "karim.hossain@example.com",
    "first_name": "Karim",
    "last_name": "Hossain"
  }
}

settings {
  encodeUrl: true
}
