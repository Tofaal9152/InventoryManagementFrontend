meta {
  name: reset password
  type: http
  seq: 2
}

post {
  url: {{base_url}}rest-auth/password/reset/confirm/
  body: json
  auth: none
}

body:json {
  {
    // The new password, entered twice. Required.
    "new_password1": "Reset-pass-789",
    "new_password2": "Reset-pass-789",

    // Both taken from the reset link: .../auth/password/reset/confirm/<uid>/<token>
    "uid": "2",
    "token": "cvqe3k-0b4c5a6d7e8f9a0b1c2d3e4f5a6b7c8d"
  }
}

docs {
  ## API explanation
  Sets a new password using the `uid` and `token` from the reset link sent by
  "submit email" (dj-rest-auth `PasswordResetConfirmView`). Public. The new
  password must pass Django's password validators.


  ## API example response
  {
    "detail": "Password has been reset with the new password."
  }

  Invalid or expired token (400):
  {
    "success": false,
    "message": "(token) Invalid value"
  }
}

settings {
  encodeUrl: true
}
