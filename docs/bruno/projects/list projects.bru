meta {
  name: list projects
  type: http
  seq: 1
}

get {
  url: {{base_url}}projects/?status=ACTIVE
  body: none
  auth: inherit
}

params:query {
  status: ACTIVE
  ~search: robot
  ~ordering: name
  ~p: 1
  ~page_size: 25
}

docs {
  ## API explanation
  Projects (FR-8.1). Any role can read, so Staff can tag takes and
  requisitions. Filters: `status` (`ACTIVE` | `CLOSED`; only ACTIVE
  projects can be selected on new operations), `search` (name or
  description). Sorting: `ordering` = `name` | `created_at` | `status`.


  ## API example response
  {
    "count": 2,
    "page_size": 25,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": 1,
        "name": "Line Follower Robot",
        "description": "Competition line follower, v2 chassis",
        "status": "ACTIVE",
        "status_display": "Active",
        "created_by": {
