meta {
  name: reopen project
  type: http
  seq: 7
}

post {
  url: {{base_url}}projects/:id/reopen/
  body: none
  auth: inherit
}

params:path {
  id: 2
}

docs {
  ## API explanation
  Makes a closed project ACTIVE again. Admin or Manager. Audited as `PROJECT_REOPENED`.

  ## API example response
  {
    "success": true,
    "message": "Project reopened.",
    "data": {
      "id": 2,
      "name": "Solar Charge Controller",
      "description": "",
      "status": "ACTIVE",
      "status_display": "Active",
      "created_by": {
        "id": 2,
        "username": "karim.hossain",
        "email": "karim.hossain@example.com",
        "role": "MANAGER"
      },
      "created_at": "2026-09-14T22:17:36.536560+06:00",
      "updated_at": "2026-09-14T22:17:37.035401+06:00"
    }
  }
}

settings {
  encodeUrl: true
}
